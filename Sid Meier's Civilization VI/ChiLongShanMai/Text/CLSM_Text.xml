		</Replace>
		<Replace Tag="LOC_PROMOTION_CLSM_LV_DESCRIPTION" Language="zh_Hans_CN">
			<Text>+2 [ICON_Movement] 移动力，+50 [ICON_Strength] 战斗力，+1 次攻击。</Text>
		</Replace>
		<Replace Tag="LOC_PROMOTION_CLSM_LV_DESCRIPTION" Language="en_US">
			<Text>+2 [ICON_Movement] Movement, +50 [ICON_Strength] Combat Strength, +1 Attack.</Text>
		</Replace>
